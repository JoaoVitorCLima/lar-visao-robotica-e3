<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_images><image id="tag42-image"><init_from>materials/textures/tag42.png</init_from></image></library_images>
  <library_effects><effect id="tag42-effect"><profile_COMMON><newparam sid="tag42-surface"><surface type="2D"><init_from>tag42-image</init_from></surface></newparam><newparam sid="tag42-sampler"><sampler2D><source>tag42-surface</source></sampler2D></newparam><technique sid="common"><phong><diffuse><texture texture="tag42-sampler" texcoord="UVMap"/></diffuse></phong></technique></profile_COMMON></effect></library_effects>
  <library_materials><material id="tag42-material" name="Tag42"><instance_effect url="#tag42-effect"/></material></library_materials>
  <library_geometries><geometry id="tag42-geometry" name="Tag42"><mesh><source id="tag42-positions"><float_array id="tag42-positions-array" count="12">-0.4 -0.4 0 0.4 -0.4 0 0.4 0.4 0 -0.4 0.4 0</float_array><technique_common><accessor source="#tag42-positions-array" count="4" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source><source id="tag42-uv"><float_array id="tag42-uv-array" count="8">0 0 1 0 1 1 0 1</float_array><technique_common><accessor source="#tag42-uv-array" count="4" stride="2"><param name="S" type="float"/><param name="T" type="float"/></accessor></technique_common></source><vertices id="tag42-vertices"><input semantic="POSITION" source="#tag42-positions"/></vertices><polylist material="Tag42" count="2"><input semantic="VERTEX" source="#tag42-vertices" offset="0"/><input semantic="TEXCOORD" source="#tag42-uv" offset="1" set="0"/><vcount>3 3</vcount><p>0 0 1 1 2 2 0 0 2 2 3 3</p></polylist></mesh></geometry></library_geometries>
  <library_visual_scenes><visual_scene id="Scene"><node id="Tag42"><instance_geometry url="#tag42-geometry"><bind_material><technique_common><instance_material symbol="Tag42" target="#tag42-material"><bind_vertex_input semantic="UVMap" input_semantic="TEXCOORD" input_set="0"/></instance_material></technique_common></bind_material></instance_geometry></node></visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
