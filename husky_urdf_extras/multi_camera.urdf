<robot>
  <link name="tracking_marker">
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.16"/></geometry>
      <material name="FluorescentGreen">
        <color rgba="0.05 1.0 0.05 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="tracking_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tracking_marker"/>
    <origin xyz="0 0 0.72"/>
  </joint>
  <gazebo reference="tracking_marker">
    <material>Gazebo/Green</material>
  </gazebo>
  <gazebo>
    <plugin name="evaluation_ground_truth" filename="libgazebo_ros_p3d.so">
      <bodyName>base_link</bodyName>
      <topicName>/evaluation/ground_truth</topicName>
      <frameName>world</frameName>
      <updateRate>100</updateRate>
      <gaussianNoise>0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
    </plugin>
  </gazebo>
</robot>
